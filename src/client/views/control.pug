doctype html
html(lang='en')
  head
    meta(charset='UTF-8')
    meta(name='viewport', content='width=device-width, initial-scale=1')
    title electerm web demo - iframe control
    style.
      * { box-sizing: border-box; }
      html, body { height: 100%; }
      body {
        margin: 0;
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        background: #0e0e10;
        color: #ddd;
        display: flex;
        flex-direction: column;
      }
      header {
        padding: 10px 16px;
        background: #16161a;
        border-bottom: 1px solid #2a2a30;
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
      }
      header h1 { font-size: 15px; margin: 0; font-weight: 600; }
      .controls { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
      button {
        background: #08c; color: #fff; border: 0; padding: 7px 12px;
        border-radius: 6px; cursor: pointer; font-size: 13px;
      }
      button:hover { filter: brightness(1.12); }
      button:disabled { opacity: .45; cursor: not-allowed; }
      .status { margin-left: auto; font-size: 12px; color: #888; }
      .status.ready { color: #06D6A0; }
      .status.error { color: #EF476F; }
      #frame-wrap { flex: 1; min-height: 0; }
      iframe { width: 100%; height: 100%; border: 0; display: block; }
  body
    header
      h1 electerm iframe control demo
      .controls
        button(data-method='setTheme', data-args='["default"]') Dark theme
        button(data-method='setTheme', data-args='["defaultLight"]') Light theme
        button(data-method='setConfig', data-args='[{"language":"en_us"}]') Lang: EN
        button(data-method='setConfig', data-args='[{"language":"zh_cn"}]') Lang: zh
        button(data-method='openSetting') Open settings
        button(data-method='addTab') New tab
        button(data-method='storeAssign', data-args='[{"showInfoPanel":true}]') Toggle info panel
        button#custom-theme(data-preset='solarizedDark') Custom theme
        button#get-theme Get current theme
      .status#status iframe not ready
    #frame-wrap
      iframe#demo(src='/', title='electerm demo')
    script.
      (function () {
        var iframe = document.getElementById('demo')
        var statusEl = document.getElementById('status')
        var ready = false
        var pending = {}
        var pingTimer = null

        function setStatus (text, cls) {
          statusEl.textContent = text
          statusEl.className = 'status' + (cls ? ' ' + cls : '')
        }

        function clearPing () {
          if (pingTimer) { clearInterval(pingTimer); pingTimer = null }
        }

        window.addEventListener('message', function (e) {
          var msg = e.data
          if (!msg || msg.source !== 'demo-control') return
          if (msg.type === 'ready') {
            if (!ready) {
              ready = true
              clearPing()
              setStatus('iframe ready', 'ready')
              updateButtons()
            }
            return
          }
          if (msg.id && pending[msg.id]) {
            var p = pending[msg.id]
            delete pending[msg.id]
            if (msg.ok) p.resolve(msg.result)
            else p.reject(new Error(msg.error))
          }
        })

        function callStore (method) {
          var args = Array.prototype.slice.call(arguments, 1)
          return new Promise(function (resolve, reject) {
            if (!ready) { reject(new Error('iframe not ready')); return }
            var id = Math.random().toString(36).slice(2)
            pending[id] = { resolve: resolve, reject: reject }
            iframe.contentWindow.postMessage(
              { source: 'parent-control', method: method, args: args, id: id },
              '*'
            )
          })
        }

        function updateButtons () {
          var btns = document.querySelectorAll('button[data-method], #custom-theme, #get-theme')
          for (var i = 0; i < btns.length; i++) btns[i].disabled = !ready
        }

        var btns = document.querySelectorAll('button[data-method]')
        for (var i = 0; i < btns.length; i++) {
          btns[i].addEventListener('click', function () {
            var b = this
            var method = b.getAttribute('data-method')
            var args = b.getAttribute('data-args')
            args = args ? JSON.parse(args) : []
            callStore.apply(null, [method].concat(args)).then(function () {
              setStatus(method + '(' + JSON.stringify(args) + ') -> ok', 'ready')
            }).catch(function (err) {
              setStatus(method + ' -> ' + err.message, 'error')
            })
          })
        }

        // Full theme configs (terminal colors + UI colors) for the "Custom theme"
        // button. Merged onto built-in defaults by store.setThemeConfig().
        var THEME_PRESETS = {
          solarizedDark: {
            themeConfig: {
              background: '#002b36',
              foreground: '#839496',
              cursor: '#93a1a1',
              selectionBackground: '#073642',
              black: '#073642',
              red: '#dc322f',
              green: '#859900',
              yellow: '#b58900',
              blue: '#268bd2',
              magenta: '#d33682',
              cyan: '#2aa198',
              white: '#eee8d5',
              brightBlack: '#002b36',
              brightRed: '#cb4b16',
              brightGreen: '#586e75',
              brightYellow: '#657b83',
              brightBlue: '#839496',
              brightMagenta: '#6c71c4',
              brightCyan: '#93a1a1',
              brightWhite: '#fdf6e3'
            },
            uiThemeConfig: {
              main: '#002b36',
              'main-dark': '#073642',
              'main-light': '#073642',
              text: '#839496',
              'text-light': '#eee8d5',
              'text-dark': '#657b83',
              'text-disabled': '#586e75',
              primary: '#268bd2',
              info: '#2aa198',
              success: '#859900',
              error: '#dc322f',
              warn: '#b58900'
            }
          }
        }

        document.getElementById('custom-theme').addEventListener('click', function () {
          var preset = THEME_PRESETS[this.getAttribute('data-preset')] || THEME_PRESETS.solarizedDark
          callStore('setThemeConfig', preset.themeConfig, preset.uiThemeConfig)
            .then(function () {
              setStatus('setThemeConfig(solarizedDark) -> ok', 'ready')
            })
            .catch(function (err) {
              setStatus('setThemeConfig -> ' + err.message, 'error')
            })
        })

        document.getElementById('get-theme').addEventListener('click', function () {
          callStore('getTheme')
            .then(function (theme) {
              var id = theme && theme.id
              var ui = theme && theme.uiThemeConfig ? theme.uiThemeConfig.main : '?'
              setStatus('current theme: ' + id + ' (main=' + ui + ')', 'ready')
              // Full config is logged for inspection.
              window.console && console.log('getTheme ->', theme)
            })
            .catch(function (err) {
              setStatus('getTheme -> ' + err.message, 'error')
            })
        })

        function ping () {
          if (ready) return
          iframe.contentWindow.postMessage(
            { source: 'parent-control', type: 'ping' },
            '*'
          )
        }

        iframe.addEventListener('load', function () {
          setStatus('iframe loading...')
          ping()
          pingTimer = setInterval(ping, 800)
        })

        updateButtons()
      })()
